%% Reservedge — Intent-to-Action booking agent — AWS Agents for Humans
%% Rendered asset: architecture.svg
%% Hosted staging uses live Bedrock. AgentCore is not deployed.

flowchart TB
  human["Human buyer"]
  ui["Responsive Reservedge UI<br/>Booking Chat · domain lanes"]
  bff["Product BFF<br/>/v1/agent/**"]
  aws["/v1/aws/plan-turns<br/>/v1/aws/execute-turns"]
  strands["Strands Agents SDK"]
  bedrock["Amazon Bedrock"]
  code["Code projector / governance<br/>Explicit · Inferred · Proposed<br/>authorization · isolation · ranking"]

  flight["flight.search<br/>LiteAPI sandbox research"]
  stay["stay.search<br/>LiteAPI sandbox research"]
  parking["parking.search<br/>simulated Curated offers"]
  experience["experience.search<br/>Prioticket, provider-limited"]
  receipt["Governed simulated action<br/>SIMULATED receipt"]

  human --> ui
  ui -->|"browser never calls Bedrock"| bff
  bff --> aws
  aws --> strands
  strands --> bedrock
  bedrock --> strands
  strands --> code
  code --> flight
  code --> stay
  code --> parking
  code --> experience
  parking --> receipt

  legend["Legend
  Sandbox research = external provider research, no booking/ticket
  Simulated Curated = no real supplier or reservation
  Human authorization at consequential transitions"]

  receipt --> legend

  classDef human fill:#f4f0e6,stroke:#3d3a34,color:#1c1916
  classDef ui fill:#e7f0ea,stroke:#2f5d50,color:#1c1916
  classDef aws fill:#e8eef7,stroke:#314a73,color:#1c1916
  classDef gov fill:#f7ead8,stroke:#8a5a12,color:#1c1916
  classDef cap fill:#eee9e2,stroke:#6b645b,color:#1c1916
  classDef sim fill:#f3e6d8,stroke:#8a5a12,color:#1c1916

  class human human
  class ui ui
  class bff,aws,strands,bedrock aws
  class code gov
  class flight,stay,experience cap
  class parking,receipt sim
