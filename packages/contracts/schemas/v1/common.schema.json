{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.itaa.invalid/v1/common.schema.json",
  "title": "ITAA common contract definitions",
  "description": "Shared v1 conventions. IDs are typed ULID tokens, never names or emails. Money is integer minor units.",
  "$defs": {
    "SchemaVersion": {
      "const": "1.0",
      "description": "Initial canonical contract profile."
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 UTC timestamp ending in Z. Calendar and clock values are validated, not only digit shape."
    },
    "MinorUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Non-negative integer minor currency units. JavaScript-safe. No floats."
    },
    "PositiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 alphabetic code, uppercase."
    },
    "IataAirportCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "IATA airport code. JFK is the v1 golden-path fixture."
    },
    "Sha256Hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 as sha256: plus 64 lowercase hex characters. Shape only in WP-02."
    },
    "IntentId": {
      "type": "string",
      "pattern": "^pi_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "BuyerToken": {
      "type": "string",
      "pattern": "^bs_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "OfferId": {
      "type": "string",
      "pattern": "^of_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "SupplierToken": {
      "type": "string",
      "pattern": "^sp_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "CounterOfferId": {
      "type": "string",
      "pattern": "^co_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "AcceptanceId": {
      "type": "string",
      "pattern": "^ac_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "AuthorizationId": {
      "type": "string",
      "pattern": "^ta_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "ApprovalId": {
      "type": "string",
      "pattern": "^ap_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^ik_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "OpaqueSignature": {
      "type": "string",
      "pattern": "^sg_[0-9a-hjkmnp-tv-z]{26}$",
      "description": "Opaque signature handle. Cryptographic verify is later work."
    },
    "EvidenceRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,80}$",
      "description": "Typed provenance reference. Not raw buyer context or competitor payloads."
    },
    "OrchestrationIntentId": {
      "type": "string",
      "pattern": "^oi_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "BookingTaskId": {
      "type": "string",
      "pattern": "^bt_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "ConversationEventId": {
      "type": "string",
      "pattern": "^ce_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "ConversationFactId": {
      "type": "string",
      "pattern": "^cf_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "PlanId": {
      "type": "string",
      "pattern": "^pl_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "LedgerId": {
      "type": "string",
      "pattern": "^ld_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "TermsHash": {
      "$ref": "#/$defs/Sha256Hash",
      "description": "Canonical terms digest. Same shape as Sha256Hash."
    },
    "OfferValidity": {
      "type": "string",
      "enum": ["valid", "expiring", "expired", "superseded"]
    },
    "InventoryState": {
      "type": "string",
      "enum": ["not_held", "subject_to_availability", "held_until"]
    },
    "TransactionResult": {
      "type": "string",
      "enum": [
        "simulated",
        "authorized_simulated",
        "authorized_live",
        "booking_pending",
        "confirmed_booking",
        "booking_failed",
        "failed",
        "cancelled"
      ]
    }
  }
}
