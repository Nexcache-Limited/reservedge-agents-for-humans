# Local development defaults only. Copy to `.env` and keep `.env` untracked.
# These values are not hosted credentials and must never be reused in cloud environments.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=itaa
POSTGRES_PASSWORD=itaa_dev_only
POSTGRES_DB=itaa_dev
POSTGRES_URL=postgresql://itaa:itaa_dev_only@localhost:5433/itaa_dev

# Stay research is server-side only. Default fake mode is credential-free for CI.
ITAA_STAY_SEARCH_MODE=fake
ITAA_LITEAPI_API_KEY=
ITAA_LITEAPI_TIMEOUT_MS=12000
# ITAA_LITEAPI_LIVE_TEST=0

# Experience research is server-side only. Default fake mode is credential-free for CI.
# Auth is OAuth2 client_credentials against the Prioticket Distributor sandbox.
# Token URL (default base): https://sandbox-distributor-api.prioticket.com/v3.8/distributor/oauth2/token
ITAA_EXPERIENCE_SEARCH_MODE=fake
ITAA_PRIOTICKET_CLIENT_ID=
ITAA_PRIOTICKET_CLIENT_SECRET=
ITAA_PRIOTICKET_TIMEOUT_MS=12000
# ITAA_PRIOTICKET_BASE_URL=https://sandbox-distributor-api.prioticket.com/v3.8/distributor
# Staging accounts may instead use https://staging-distributor-api.prioticket.com/v3.8/distributor

# Reserved names for later packages. Leave empty locally.
# GOOGLE_CLOUD_PROJECT=
# AWS_REGION=
# REVENUECAT_API_KEY=
