# Non-secret names only. Never commit values.
ITAA_AWS_MODEL_MODE=fake
ITAA_AWS_ADAPTER_URL=http://127.0.0.1:8080
ITAA_AWS_MODEL=global.anthropic.claude-sonnet-4-6
ITAA_CORS_ORIGINS=http://localhost:5173,https://app.example.invalid
PORT=8080
# ITAA_AWS_LIVE is a deprecated alias for selecting live mode only when
# ITAA_AWS_MODEL_MODE is unset.
# Credentialed tests use ITAA_AWS_LIVE_TEST=1 and are skipped in CI.
# Live composition requires ITAA_AWS_TIMEOUT_MS (integer 5000-45000).
# Fake mode ignores a valid timeout.
# ITAA_AWS_TIMEOUT_MS=30000
# Live InvokeModel/Converse stays fail-closed unless an authorized local UAT sets:
# ITAA_AWS_LIVE_INVOKE=1
# Owner supplies AWS credentials at runtime. Do not commit keys.
