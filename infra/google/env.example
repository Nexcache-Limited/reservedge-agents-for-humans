# Non-secret names only. Never commit values.
ITAA_GOOGLE_MODEL_MODE=fake
ITAA_GEMINI_MODEL=gemini-2.5-flash
ITAA_GCP_REGION=us-central1
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
ITAA_CORS_ORIGINS=http://localhost:5173,https://app.example.invalid
PORT=8080
# Owner supplies GOOGLE_CLOUD_PROJECT at deploy time. Do not commit a project id.
# ADC is provided by Cloud Run. Do not copy a credentials JSON into the image.
# ITAA_GOOGLE_LIVE is a deprecated alias for selecting live mode only.
# Credentialed tests use ITAA_GOOGLE_LIVE_TEST=1 and are skipped in CI.
# Live composition requires ITAA_GOOGLE_TIMEOUT_MS (integer 5000-45000, below
# Cloud Run timeoutSeconds=60). Fake mode ignores a valid value.
# ITAA_GOOGLE_TIMEOUT_MS=30000
